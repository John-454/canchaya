# ============================================================================
# canchaya. — Frontend (.env de desarrollo)
# Copia este archivo como `frontend/.env` y rellena los valores.
#   PowerShell:  Copy-Item .env.example .env
#
# Las variables VITE_* son PÚBLICAS (se incluyen en el bundle del navegador).
# Usa SIEMPRE la anon/publishable key. NUNCA la service_role.
# ============================================================================

# Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://<ref>.supabase.co

# Project Settings -> API -> anon / publishable key
VITE_SUPABASE_ANON_KEY=

# Ruta base de la API. En desarrollo el proxy de Vite ya apunta a :8000.
VITE_API_BASE=/api/v1
