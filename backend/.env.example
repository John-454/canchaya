# ============================================================================
# canchaya. — Backend (.env de desarrollo)
# Copia este archivo como `backend/.env` y rellena los valores.
#   PowerShell:  Copy-Item .env.example .env
# NUNCA subas el .env real al repositorio.
# ============================================================================

# ==== Django ====
# Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=dev-cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Bogota

# ==== PostgreSQL ====
# Opción A (recomendada): URI del Session pooler de Supabase (puerto 5432).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Si la contraseña tiene caracteres especiales, URL-encódelos (@ -> %40, # -> %23).
DATABASE_URL=

# Opción B: variables sueltas (se ignoran si DATABASE_URL está definida).
POSTGRES_DB=canchaya
POSTGRES_USER=canchaya
POSTGRES_PASSWORD=canchaya
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ==== Supabase ====
# Project Settings -> API -> Project URL
SUPABASE_URL=https://<ref>.supabase.co
# Solo si el proyecto firma JWT con HS256 (clave "Legacy JWT Secret").
# Si usa RS256 (recomendado), déjalo vacío: se valida por JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_CACHE_TTL=3600

# ==== CORS / CSRF ====
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ==== Producción (opcional) ====
# SECURE_HSTS_PRELOAD=False
# GUNICORN_WORKERS=3
# DESPLIEGUE_SIN_MIGRATE=0
